/**
 * 本地大模型推理与视频抽帧服务 (Mac M1 Pro Metal GPU 原生驱动)
 * 支持 Ollama 本地服务探测、HTML5 Canvas 硬件截帧、VLM 多模态时序工步推理
 */

const OLLAMA_HOST = 'http://127.0.0.1:11434';

/**
 * 探测本地 Ollama 与已安装的视觉大模型健康状况
 */
export async function checkLocalModelHealth() {
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 2000);

    const res = await fetch(`${OLLAMA_HOST}/api/tags`, {
      method: 'GET',
      signal: controller.signal,
    });
    clearTimeout(timeoutId);

    if (!res.ok) {
      return {
        online: false,
        service: 'Ollama 未运行',
        models: [],
        activeModel: null,
      };
    }

    const data = await res.json();
    const models = (data.models || []).map((m) => m.name);
    // 优先使用 Qwen3-VL，其次 Qwen2.5-VL，最后回退 moondream
    const qwen3Model = models.find((m) => m.toLowerCase().includes('qwen3-vl') || m.toLowerCase().includes('qwen3'));
    const qwenModel = models.find((m) => m.toLowerCase().includes('qwen'));
    const moondreamModel = models.find((m) => m.toLowerCase().includes('moondream'));
    const activeModel = qwen3Model || qwenModel || moondreamModel || 'qwen3-vl:2b';

    const isQwen3 = activeModel.toLowerCase().includes('qwen3');
    const isQwen = activeModel.toLowerCase().includes('qwen');

    return {
      online: true,
      service: isQwen3
        ? 'Ollama (阿里通义千问 Qwen3-VL · M1 Pro Metal GPU加速)'
        : isQwen
        ? 'Ollama (阿里通义千问 Qwen2.5-VL · M1 Pro Metal GPU加速)'
        : 'Ollama (本地原生 M1 Pro Metal GPU 加速)',
      host: OLLAMA_HOST,
      models,
      activeModel,
      hardware: {
        chip: 'Apple M1 Pro (arm64 10核)',
        memory: '16GB 统一内存',
        acceleration: 'Apple Metal (MPS GPU 硬件加速)',
      },
    };
  } catch (err) {
    return {
      online: false,
      service: 'Ollama 服务离线',
      error: err.message,
      models: [],
      activeModel: null,
    };
  }
}

/**
 * 从 HTML5 <video> 元素中采样关键帧并通过 Canvas 导出 JPEG Base64
 * @param {HTMLVideoElement} videoEl
 * @param {number} totalFrames
 * @param {number} fps
 * @param {number} sampleCount
 * @returns {Promise<Array<{ frameIndex: number, timestamp: number, base64: string }>>}
 */
export async function extractKeyframesFromVideo(videoEl, totalFrames, fps = 30, sampleCount = 6) {
  if (!videoEl || !videoEl.duration || videoEl.duration <= 0) {
    return [];
  }

  const duration = videoEl.duration;
  const canvas = document.createElement('canvas');
  // 缩放到 640x360 以保证极速传输与毫秒级推理
  canvas.width = 640;
  canvas.height = 360;
  const ctx = canvas.getContext('2d');

  const keyframes = [];
  // 采样点分布（避开最前最后微小空隙）
  const sampleRatios = [0.05, 0.20, 0.40, 0.60, 0.80, 0.95];

  const originalTime = videoEl.currentTime;

  for (let i = 0; i < Math.min(sampleCount, sampleRatios.length); i++) {
    const targetTime = duration * sampleRatios[i];
    const frameIdx = Math.round(targetTime * fps);

    try {
      await new Promise((resolve) => {
        let isDone = false;
        const handleSeeked = () => {
          if (isDone) return;
          isDone = true;
          videoEl.removeEventListener('seeked', handleSeeked);
          resolve();
        };
        videoEl.addEventListener('seeked', handleSeeked);
        videoEl.currentTime = targetTime;
        // 500ms 超时保护
        setTimeout(() => {
          if (!isDone) {
            isDone = true;
            videoEl.removeEventListener('seeked', handleSeeked);
            resolve();
          }
        }, 500);
      });

      if (ctx) {
        ctx.drawImage(videoEl, 0, 0, canvas.width, canvas.height);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
        // 去除 data:image/jpeg;base64, 前缀
        const base64Clean = dataUrl.replace(/^data:image\/\w+;base64,/, '');
        keyframes.push(  * 具身智能平台标准数据字典 (受控词表 Controlled Taxonomy)
 */
export const STANDARD_TAXONOMY = {
  arms: ['右手 (Right Arm)', '左手 (Left Arm)', '双手协作 (Dual Arms)'],
  skills: [
    '避障接近', '抓取与定位', '取物放置', '松开释放', '等待观望',
    '拧紧螺丝', '工具拿起', '协同扶持', '盖帽防护', '扫码同步', '精密装配',
    '抬起物料', '旋转对齐'
  ],
  objects: [
    '物料周转托盘', '橙色物料工件', '操作工作台',
    '电动螺栓枪/电钻', '装配螺栓 (第1颗)', '装配螺栓 (第2颗)', '装配螺栓 (第3颗)', '装配螺栓 (第4颗)',
    '动力电池包/模组', '绝缘保护帽 (正极)', '绝缘保护帽 (负极)', '同步手机二维码', '六角螺母'
  ],
  goals: [
    '接近到位', '夹持锁定', '平稳入箱', '安全释手', '零位复位',
    '工具稳固握持', '螺栓扭矩紧固', '电池模组稳固支撑', '导电口绝缘遮蔽', '时钟同步对齐',
    '待分拣混料盒 -> 分类料盒', '工作台区域 -> 工作台区域'
  ]
};

/**
 * 将自由语义词汇严格对齐到受控数据字典
 */
export function normalizeToStandardTaxonomy(step = {}) {
  let skill = step.skill || '抓取与定位';
  let object = step.object || '橙色物料工件';
  let goal = step.goal || '接近到位';
  let arm = step.arm || '右手 (Right Arm)';
  const content = step.stepContent || '';

  // 1. 技能对齐
  if (/接近|下探|移动至|探测|approach|移至/i.test(skill) && !/抓取|拿取/i.test(skill)) {
    skill = '避障接近';
  } else if (/抓取|定位|拿取|夹持|拾取|pick/i.test(skill) || /抓取|夹持/i.test(content)) {
    skill = '抓取与定位';
  } else if (/放|搬运|移入|入箱|运送|place/i.test(skill) || /搬运|放入/i.test(content)) {
    skill = '取物放置';
  } else if (/松开|释放|脱离|release/i.test(skill) || /松开|释放/i.test(content)) {
    skill = '松开释放';
  } else if (/观望|等待|复位|待命|归位|reset|wait/i.test(skill) || /回原位|待命/i.test(content)) {
    skill = '等待观望';
  } else if (/拧|紧固|旋|screw/i.test(skill)) {
    skill = '拧紧螺丝';
  } else if (/工具|拿起/i.test(skill)) {
    skill = '工具拿起';
  } else if (/扶持|支撑|协同/i.test(skill)) {
    skill = '协同扶持';
  } else if (/盖帽|防护|绝缘帽/i.test(skill)) {
    skill = '盖帽防护';
  } else if (/扫码|对齐|二维码/i.test(skill)) {
    skill = '扫码同步';
  } else if (/装配|精密/i.test(skill)) {
    skill = '精密装配';
  } else if (/抬起|分拣/i.test(skill) || /抬起/i.test(content)) {
    skill = '抬起物料';
  } else if (/旋转|对齐/i.test(skill) || /旋转/i.test(content)) {
    skill = '旋转对齐';
  }

  // 2. 操作对象对齐
  if (/托盘|周转|蓝色盒|箱子/i.test(object) || /周转盒|塑料盒|托盘/i.test(content)) {
    object = '物料周转托盘';
  } else if (/积木|方块|工件|物料|零件|橙色/i.test(object) || /积木|方块/i.test(content)) {
    object = '橙色物料工件';
  } else if (/工作台|台面|桌面/i.test(object)) {
    object = '操作工作台';
  } else if (/电钻|起子|螺栓枪|电动/i.test(object)) {
    object = '电动螺栓枪/电钻';
  } else if (/螺母|六角/i.test(object) || /六角螺母/i.test(content)) {
    object = '六角螺母';
  } else if (/螺丝|螺栓/i.test(object)) {
    object = object.includes('2') ? '装配螺栓 (第2颗)' : (object.includes('3') ? '装配螺栓 (第3颗)' : (object.includes('4') ? '装配螺栓 (第4颗)' : '装配螺栓 (第1颗)'));
  } else if (/电池/i.test(object)) {
    object = '动力电池包/模组';
  } else if (/绝缘|保护帽|帽/i.test(object)) {
    object = object.includes('负') ? '绝缘保护帽 (负极)' : '绝缘保护帽 (正极)';
  } else if (/二维码|手机/i.test(object)) {
    object = '同步手机二维码';
  }

  // 3. 达成意图对齐
  if (/接近|到达/i.test(goal) || skill === '避障接近') {
    goal = '接近到位';
  } else if (/锁定|夹紧|抓稳|抓取/i.test(goal) || skill === '抓取与定位') {
    goal = '夹持锁定';
  } else if (/入箱|放置到位|入盒/i.test(goal) || skill === '取物放置') {
    goal = '平稳入箱';
  } else if (/释手|松开|脱离/i.test(goal) || skill === '松开释放') {
    goal = '安全释手';
  } else if (/复位|归位|待命/i.test(goal) || skill === '等待观望') {
    goal = '零位复位';
  } else if (/紧固|扭矩/i.test(goal) || skill === '拧紧螺丝') {
    goal = '螺栓扭矩紧固';
  } else if (/握持|拿稳/i.test(goal) || skill === '工具拿起') {
    goal = '工具稳固握持';
  } else if (/扶持|防倾覆|支撑/i.test(goal) || skill === '协同扶持') {
    goal = '电池模组稳固支撑';
  } else if (/遮蔽|绝缘/i.test(goal) || skill === '盖帽防护') {
    goal = '导电口绝缘遮蔽';
  } else if (/时钟|同步/i.test(goal) || skill === '扫码同步') {
    goal = '时钟同步对齐';
  } else if (/待分拣|分类料盒/i.test(goal) || skill === '抬起物料') {
    goal = '待分拣混料盒 -> 分类料盒';
  } else if (/工作台区域/i.test(goal) || skill === '旋转对齐') {
    goal = '工作台区域 -> 工作台区域';
  }

  // 4. 手臂执行器对齐
  if (/左/i.test(arm)) {
    arm = '左手 (Left Arm)';
  } else if (/双/i.test(arm)) {
    arm = '双手协作 (Dual Arms)';
  } else {
    arm = '右手 (Right Arm)';
  }

  return {
    ...step,
    arm,
    skill,
    object,
    goal,
    color: skill === '拧紧螺丝' ? '#fa541c' : (skill === '避障接近' ? '#10b981' : (skill === '抓取与定位' ? '#1677ff' : (skill === '取物放置' ? '#52c41a' : (skill === '松开释放' ? '#722ed1' : (skill === '抬起物料' ? '#52c41a' : (skill === '旋转对齐' ? '#eb2f96' : '#8c8c8c')))))),
  };
}

