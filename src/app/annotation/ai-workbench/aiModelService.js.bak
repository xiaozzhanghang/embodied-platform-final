    actionSkill: '旋转对齐',
    object: '六角螺母',
    actionTarget: '六角螺母',
    goal: '工作台区域 -> 工作台区域',
    expectedGoal: '工作台区域 -> 工作台区域',
    startFrame: 5143,
    endFrame: 7342,
    confidence: 0.928,
    displayConfidence: '92.8% (高)',
    annoOverlap: 0,
    stepContent: '六角螺母姿态纠偏与旋转微调，使法兰面与螺纹完全平行对齐 [5143, 7342)',
    vlmInsight: '[Qwen3-VL 原生视觉识别] 六角螺母姿态纠偏与旋转微调对齐 [5143, 7342)',
  },
  {
    stepNo: 12,
    arm: '双手 (Dual Arms)',
    effector: '双臂',
